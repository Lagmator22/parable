# ---------------- BOT BRAINS (each bot can use a different one; the report card compares them) ----------------
# rule          = free built-in rule (always available, also the automatic fallback)
# Claude hosting is optional. Set CLAUDE_MODELS and a funded ANTHROPIC_API_KEY to enable it.
# gemini        = Google Gemini via its OpenAI-style API (free tier)       -> paste GEMINI_API_KEY below
# gemma         = Google Gemma 4 31B hosted by Google (same key, free tier)
# local         = a model running on your own machine via Ollama (e.g. Gemma 4 small), no internet needed
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-flash
GEMMA_MODELS=gemma-4-31b-it,gemma-4-26b-a4b-it
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma4:e4b

# Jev brain (Autoloops): scores buy/sell/hold with probabilities. Free $1 credit at https://autoloops.ai/console
AUTOLOOPS_API_KEY=
JEV_MODELS=gemma-4-31b-it,deepseek-v4.1-flash

# Demo approval (no World App, bots marked "demo"): off unless 1. Rate-limited to 3 per 10 minutes.
WORLD_ALLOW_DEMO=0
